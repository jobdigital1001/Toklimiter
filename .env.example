# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/contextbudget?schema=public"
# Direct (non-pooled) connection used for migrations. Same as DATABASE_URL unless
# your provider gives you a separate pooled URL (Neon, Supabase, Vercel Postgres).
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/contextbudget?schema=public"

# Public base URL of the app (no trailing slash).
NEXTAUTH_URL="http://localhost:3000"
# Session signing/encryption secret. Generate: openssl rand -base64 32
NEXTAUTH_SECRET=""

# GitHub App (recommended) or OAuth App credentials.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# OAuth scopes, only used by classic OAuth Apps (GitHub Apps ignore scopes).
# Default "read:user" gives access to public repositories only.
# Add "repo" only if you must audit private repositories with an OAuth App.
GITHUB_OAUTH_SCOPE="read:user"

# 32-byte key (base64) used to encrypt GitHub tokens at rest.
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""
