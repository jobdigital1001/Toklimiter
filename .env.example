# ── Database (PostgreSQL) ──────────────────────────────────────────────
DATABASE_URL="postgresql://genius:genius@localhost:5432/genius_jobportal"

# ── App ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Auth.js ────────────────────────────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET=""
# OAuth providers are optional; a provider is enabled only when both values are set.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Resend (transactional email) ───────────────────────────────────────
# Without a key, emails are logged to the server console instead of sent.
RESEND_API_KEY=""
EMAIL_FROM="Genius JobPortal <noreply@example.com>"

# ── File storage (CV uploads) ──────────────────────────────────────────
# Vercel Blob token. Without it, files are stored on local disk in ./.uploads (dev only).
BLOB_READ_WRITE_TOKEN=""

# ── Cron (job alerts) ──────────────────────────────────────────────────
# Vercel Cron sends this as a Bearer token to /api/cron/job-alerts.
CRON_SECRET=""
